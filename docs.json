{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "XSDR",
  "colors": {
    "primary": "#16A34A",
    "light": "#acffa1",
    "dark": "#27272a"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "favicon": "/logo/favicon.ico",
  "fonts": {
    "family": "Inter"
  },
  "icons": {
    "library": "lucide"
  },
  "background": {
    "color": {
      "dark": "#09090b"
    }
  },
  "thumbnails": {
    "appearance": "dark"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": ["index", "installation"]
          },
          {
            "group": "Concepts",
            "pages": ["webhooks", "mcp-server", "rules"]
          },
          {
            "group": "Platforms",
            "pages": ["x", "firehose", "polymarket"]
          }
        ]
      },
      {
        "tab": "API Reference",
        "openapi": "/openapi.json"
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/Mintlify Logo.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@xsdr.app"
      },
      {
        "type": "discord",
        "label": "Discord",
        "href": "https://discord.gg/PjrRU4g3GV"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://xsdr.app/dashboard"
    }
  },
  "contextual": {
    "options": ["copy", "mcp"]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/TryXSDR",
      "github": "https://github.com/xsdr-ai"
    }
  }
}
